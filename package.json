{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "check-env": "node scripts/check-env.js",
    "dev": "npm run check-env && next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --only database --config firebase.strict.json --project demo-stokmanager-test \"node --test tests/database.rules.test.mjs\"",
    "test:rules:raw": "node --test tests/database.rules.test.mjs",
    "test:predict": "python3 -m unittest tests/test_predict_api.py",
    "seed:honda": "tsx scripts/generate-honda-dummy.ts",
    "seed:honda:firebase": "tsx scripts/generate-honda-dummy.ts --firebase --confirm",
    "migrate:strip-price": "node scripts/migrate-strip-price.mjs",
    "migrate:strip-price:apply": "node scripts/migrate-strip-price.mjs --apply",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bwip-js": "^4.11.1",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "firebase-admin": "13.10.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.454.0",
    "next": "^16.2.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "9.30.0",
    "eslint-config-next": "^16.2.6",
    "firebase-tools": "^15.21.0",
    "postcss": "^8.5.15",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@grpc/grpc-js@<=1.9.15": "1.14.4",
    "brace-expansion@2.0.0 - 2.0.2": "2.0.3",
    "minimatch@9.0.0 - 9.0.6": "9.0.7",
    "picomatch@<=2.3.1": "2.3.2",
    "postcss@<8.5.10": "8.5.15"
  }
